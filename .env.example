# ===================================================================
# SIH26122 — Environment Variables
# Copy this to .env and fill in real values. NEVER commit .env.
# ===================================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://kranti:kranti_secret@localhost:5432/sih26122
DATABASE_URL_SYNC=postgresql+psycopg2://kranti:kranti_secret@localhost:5432/sih26122

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- MinIO (S3-compatible object storage) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_RAW=sih-ingestion-raw
MINIO_BUCKET_EXTRACTED=sih-ingestion-extracted
MINIO_SECURE=false

# --- WhatsApp Cloud API ---
# Get these from Meta Developer Console → WhatsApp → Configuration
WHATSAPP_APP_SECRET=your_whatsapp_app_secret_here
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token_here
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# --- LLM: Local Ollama (PRIMARY — run: ollama pull qwen3:8b) ---
# Qwen3-8B: reliable single-GPU local inference (~8-10 GB VRAM at Q4/Q5).
# The newer Qwen3.8-27B line was ruled out as too heavy for live-demo inference.
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen3:8b

# --- LLM: Groq (FALLBACK for both extraction AND re-ranking) ---
# Named GROQ_MODEL_FALLBACK — not GROQ_MODEL_RERANK — because this single model
# serves as the fallback for two different call sites (extraction + re-ranking).
# Get free API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_FALLBACK=qwen/qwen3-32b

# --- Matching Thresholds (configurable, no code change needed) ---
MATCH_AUTO_ACCEPT_THRESHOLD=0.85
MATCH_REVIEW_THRESHOLD=0.55

# --- Qdrant Vector DB ---
# In Docker: http://qdrant:6333 (service name)
# Local dev without Docker: http://localhost:6333
QDRANT_URL=http://localhost:6333

# --- Institutional Memory ---
QDRANT_COLLECTION_EVENTS=progress_events
QDRANT_COLLECTION_ACTIVITIES=plan_activities

# --- Auth ---
# Shared legacy token (kept for backward compat with tests/scripts).
# For real reviewer identity, use POST /auth/login from the dashboard.
REVIEWER_TOKEN=dev-insecure-token

# --- faster-whisper ---
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
PROJECT_ID=OIL_Pipeline_2026_Demo
