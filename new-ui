<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Kranti P1 — Project Dashboard</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    /* ---- core palette: "blueprint" — engineering-drawing navy + safety-amber ---- */
    --bg:#eef1f6;
    --surface:#ffffff;
    --surface-alt:#f6f8fb;
    --border:#e0e5ec;
    --border-strong:#ccd3e0;
    --ink:#101826;
    --ink-soft:#525c6e;
    --muted:#8b93a3;
    --accent:#d9822b;
    --accent-soft:#fbeadb;
    --accent-ink:#8a5316;
    --success:#2f9e63;
    --success-soft:#e5f6ec;
    --danger:#e0574c;
    --danger-soft:#fdecea;
    --info:#2f6fed;

    /* ---- Kranti AI: same neutral black/white minimal family as the rest of the UI ---- */
    --ai-bg:#fafafa;
    --ai-surface:#ffffff;
    --ai-surface2:#f7f7f7;
    --ai-surface3:#eeeeee;
    --ai-border:#e2e2e2;
    --ai-border-strong:#cfcfcf;
    --ai-text:#111111;
    --ai-text-soft:#6b6b6b;
    --ai-muted:#9a9a9a;

    --radius-lg:14px;
    --radius-md:10px;
    --radius-sm:7px;
    --shadow:0 1px 2px rgba(16,24,38,.04), 0 6px 20px rgba(16,24,38,.06);
  }
  *{box-sizing:border-box;}
  html,body{ margin:0;padding:0;height:100%; }
  body{
    font-family:"IBM Plex Sans",Arial,sans-serif;
    color:var(--ink);
    background:var(--bg);
    height:100vh;
    min-height:660px;
    overflow:hidden;
  }
  ::-webkit-scrollbar{ width:9px; height:9px; }
  ::-webkit-scrollbar-thumb{ background:#c7cedb; border-radius:6px; }
  ::-webkit-scrollbar-track{ background:transparent; }
  .ai-frame ::-webkit-scrollbar-thumb{ background:#cfcfcf; }
  .mono{ font-family:"IBM Plex Mono",monospace; }

  /* ============ VIEW ROUTER ============ */
  .view{ display:none; width:100%; height:100vh; }
  .view.active{ display:flex; }
  #view-dashboard.active{ padding:16px; gap:16px; align-items:stretch; }
  #view-auth.active, #view-navigator.active{ align-items:center; justify-content:center; }

  /* ============ AUTH SCREEN ============ */
  #view-auth{ background:var(--bg); }
  .auth-card{
    position:relative; width:860px; max-width:94vw; min-height:540px;
    background:var(--surface); border-radius:var(--radius-lg); overflow:hidden;
    box-shadow:0 2px 4px rgba(16,24,38,.05), 0 24px 60px rgba(16,24,38,.14);
  }
  .auth-form-panel{ position:absolute; top:0; height:100%; width:50%; left:0; transition:all .6s ease-in-out; }
  .sign-up-panel{ opacity:0; z-index:1; }
  .sign-in-panel{ z-index:2; }
  .auth-card.right-active .sign-in-panel{ transform:translateX(100%); }
  .auth-card.right-active .sign-up-panel{ transform:translateX(100%); opacity:1; z-index:5; }
  .auth-form{
    display:flex; flex-direction:column; height:100%; justify-content:center;
    padding:0 52px; gap:12px;
  }
  .auth-form h2{ font-size:22px; font-weight:600; margin:0 0 4px; letter-spacing:.1px; }
  .auth-sub{ font-size:12.5px; color:var(--muted); margin:0 0 6px; }
  .auth-google{
    display:flex; align-items:center; justify-content:center; gap:9px;
    font-family:inherit; font-size:12.5px; font-weight:600; color:var(--ink-soft);
    background:var(--surface); border:1px solid var(--border-strong); border-radius:var(--radius-sm);
    padding:10px; cursor:pointer; margin-top:2px;
  }
  .auth-google:hover{ background:var(--surface-alt); }
  .auth-google .g-mark{
    width:16px;height:16px;border-radius:50%;background:var(--ink);color:#fff;
    font-size:10px;font-weight:700;display:flex;align-items:center;justify-content:center;
  }
  .auth-field{
    display:flex; align-items:center; gap:9px;
    border:1px solid var(--border); border-radius:var(--radius-sm);
    background:var(--surface-alt); padding:10px 12px;
  }
  .auth-field:focus-within{ border-color:var(--ink-soft); background:var(--surface); }
  .auth-field .auth-icon{ display:inline-flex; align-items:center; justify-content:center; color:var(--muted); flex:0 0 auto; }
  .auth-field .auth-icon svg{ display:block; }
  .auth-field input{
    border:none; background:transparent; outline:none; font-family:inherit;
    font-size:13px; color:var(--ink); width:100%;
  }
  .auth-link{ align-self:flex-end; font-size:11.5px; color:var(--ink-soft); text-decoration:none; margin-top:-4px; }
  .auth-link:hover{ color:var(--ink); text-decoration:underline; }
  .auth-submit{
    margin-top:8px; font-family:inherit; font-size:13px; font-weight:600; color:#fff;
    background:var(--ink); border:none; border-radius:var(--radius-sm); padding:12px; cursor:pointer;
    transition:background .12s ease;
  }
  .auth-submit:hover{ background:#000; }

  .auth-overlay-container{
    position:absolute; top:0; left:50%; width:50%; height:100%; overflow:hidden;
    transition:transform .6s ease-in-out; z-index:100;
  }
  .auth-card.right-active .auth-overlay-container{ transform:translateX(-100%); }
  .auth-overlay{
    position:relative; left:-100%; height:100%; width:200%;
    background:linear-gradient(155deg,#101826 0%,#1c2636 100%);
    color:#fff; transform:translateX(0); transition:transform .6s ease-in-out;
  }
  .auth-card.right-active .auth-overlay{ transform:translateX(50%); }
  .auth-overlay-panel{
    position:absolute; top:0; width:50%; height:100%;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    padding:0 42px; text-align:center; transition:transform .6s ease-in-out;
  }
  .overlay-left{ left:0; transform:translateX(-20%); }
  .auth-card.right-active .overlay-left{ transform:translateX(0); }
  .overlay-right{ right:0; transform:translateX(0); }
  .auth-card.right-active .overlay-right{ transform:translateX(20%); }
  .auth-overlay-panel .brand-mark{
    width:14px;height:14px;background:var(--accent); border-radius:3px; transform:rotate(45deg); margin-bottom:18px;
  }
  .auth-overlay-panel h2{ font-size:20px; font-weight:600; margin:0 0 12px; }
  .auth-overlay-panel p{ font-size:12.5px; line-height:1.6; color:#c7cedc; margin:0 0 22px; }
  .auth-ghost-btn{
    font-family:inherit; font-size:12px; font-weight:600; color:#fff;
    background:transparent; border:1px solid rgba(255,255,255,.5); border-radius:20px;
    padding:10px 30px; cursor:pointer; transition:background .15s ease, border-color .15s ease;
  }
  .auth-ghost-btn:hover{ background:rgba(255,255,255,.1); border-color:var(--accent); }

  /* ============ NAVIGATOR SCREEN ============ */
  #view-navigator{ background:#12161d; }
  .nav-card{
    width:420px; max-width:92vw; background:#1a1f29; border:1px solid #2a3140;
    border-radius:var(--radius-lg); padding:26px 24px 20px; box-shadow:0 24px 60px rgba(0,0,0,.35);
  }
  .nav-title{ color:#fff; font-size:16px; font-weight:600; text-align:center; margin:4px 0 20px; }
  .nav-options{ display:flex; flex-direction:column; gap:10px; }
  .nav-option{
    display:flex; align-items:center; gap:13px; width:100%; text-align:left;
    background:#232936; border:1px solid #2f3646; border-radius:var(--radius-md);
    padding:12px 14px; cursor:pointer; transition:background .12s ease, border-color .12s ease;
  }
  .nav-option:hover{ background:#282f3d; border-color:#3a4257; }
  .nav-option .nav-icon{
    flex:0 0 auto; width:34px; height:34px; border-radius:9px;
    background:#333c4d; color:#dbe1ec; display:flex; align-items:center; justify-content:center; font-size:15px;
  }
  .nav-option.featured .nav-icon{ background:var(--accent); color:#1a1206; }
  .nav-text{ display:flex; flex-direction:column; gap:2px; }
  .nav-text strong{ color:#f2f4f8; font-size:13px; font-weight:600; }
  .nav-text small{ color:#8b93a3; font-size:11px; }
  .nav-signout{
    margin:18px auto 2px; display:block; background:none; border:none; cursor:pointer;
    font-family:inherit; font-size:11.5px; color:#6b7385; padding:4px;
  }
  .nav-signout:hover{ color:#c7cedc; }

  /* ============ TITLEBAR NAV CONTROL ============ */
  .titlebar-back{
    margin-left:auto; font-family:inherit; font-size:11.5px; font-weight:500;
    color:var(--ink-soft); background:var(--surface-alt); border:1px solid var(--border);
    border-radius:20px; padding:6px 13px; cursor:pointer; display:flex; align-items:center; gap:6px;
  }
  .titlebar-back:hover{ background:var(--border); color:var(--ink); }

  /* ============ REVIEW QUEUE DRAWER ============ */
  .expand-btn{
    width:20px;height:20px;flex:0 0 auto; margin-left:4px;
    border:none;background:transparent;color:var(--ai-text-soft);
    font-size:13px; cursor:pointer; border-radius:5px;
    display:flex;align-items:center;justify-content:center;
    transition:background .12s ease, color .12s ease;
  }
  .expand-btn:hover{ background:var(--ai-surface3); color:var(--ai-text); }
  .drawer-overlay{
    position:fixed; inset:0; background:rgba(16,24,38,.4);
    display:flex; justify-content:flex-end;
    opacity:0; pointer-events:none; transition:opacity .25s ease; z-index:500;
  }
  .drawer-overlay.open{ opacity:1; pointer-events:auto; }
  .review-drawer{
    width:min(1000px,92vw); height:100%; background:var(--surface);
    box-shadow:-10px 0 34px rgba(16,24,38,.2);
    transform:translateX(100%); transition:transform .32s cubic-bezier(.22,.9,.32,1);
    display:flex; flex-direction:column;
  }
  .drawer-overlay.open .review-drawer{ transform:translateX(0); }
  .drawer-header{
    display:flex; align-items:flex-start; justify-content:space-between;
    padding:22px 28px; border-bottom:1px solid var(--border); flex:0 0 auto;
  }
  .drawer-header-title{ display:flex; align-items:center; gap:10px; }
  .drawer-header-title .brand-mark{ width:11px;height:11px;background:var(--accent); border-radius:3px; transform:rotate(45deg); }
  .drawer-header h2{ margin:0; font-size:18px; font-weight:600; }
  .drawer-sub{ margin:4px 0 0; font-size:12px; color:var(--muted); }
  .drawer-close{
    border:none; background:var(--surface-alt); width:32px;height:32px;border-radius:9px;
    font-size:19px; line-height:1; cursor:pointer; color:var(--ink-soft);
  }
  .drawer-close:hover{ background:var(--border); color:var(--ink); }
  .drawer-body{ flex:1 1 auto; display:flex; min-height:0; }
  .drawer-list{ width:360px; flex:0 0 360px; border-right:1px solid var(--border); overflow-y:auto; padding:16px; display:flex; flex-direction:column; gap:8px; }
  .drawer-detail{ flex:1 1 auto; overflow-y:auto; padding:30px 34px; }
  .drawer-placeholder{ color:var(--muted); font-size:13px; text-align:center; margin-top:80px; }

  .drawer-card{
    background:var(--surface-alt); border:1px solid var(--border); border-radius:var(--radius-sm);
    padding:12px 13px; cursor:pointer; transition:border-color .12s ease, background .12s ease;
  }
  .drawer-card:hover{ border-color:var(--border-strong); background:#eef0f4; }
  .drawer-card.active{ background:#fff; border-color:var(--ink); box-shadow:0 0 0 1px var(--ink) inset; }
  .drawer-card.empty-placeholder{ opacity:.45; cursor:default; }
  .drawer-card .row1{ display:flex; align-items:center; gap:8px; margin-bottom:5px; }
  .drawer-card .evt-id{ font-size:10.5px; font-weight:600; color:var(--muted); }
  .drawer-card .tag{
    margin-left:auto; font-size:9px; font-weight:600; color:var(--ink-soft);
    background:var(--surface); border:1px solid var(--border); padding:2px 8px; border-radius:20px;
  }
  .drawer-card .preview{ font-size:12.5px; color:var(--ink); line-height:1.45; }

  .status-chip{ font-size:9px; font-weight:600; padding:2px 8px; border-radius:20px; }
  .status-chip.accepted{ background:var(--ink); color:#fff; }
  .status-chip.declined{ background:var(--surface); color:var(--muted); border:1px solid var(--border-strong); }

  .drawer-agent{ display:flex; flex-direction:column; gap:20px; max-width:640px; }
  .message-text.big{ font-size:14px; padding:16px 18px; }
  .activity-match.big{ padding:13px 15px; }
  .confidence-bar.big{ height:8px; }
  .agent-actions.big button{ font-size:13px; padding:11px 10px; }

  /* ============ OUTER FRAMES ============ */
  .frame{
    border:1px solid var(--border);
    border-radius:var(--radius-lg);
    background:var(--surface);
    box-shadow:var(--shadow);
    display:flex;
    flex-direction:column;
    overflow:hidden;
  }
  .p1-frame{ flex:1 1 auto; min-width:0; }
  .ai-frame{ width:300px; flex:0 0 300px; background:var(--ai-bg); border-color:var(--ai-border); }

  .frame-titlebar{
    display:flex;align-items:center;gap:9px;
    padding:14px 18px;
    border-bottom:1px solid var(--border);
    flex:0 0 auto;
  }
  .frame-titlebar h1{
    font-size:14.5px; font-weight:600; margin:0; letter-spacing:.1px;
  }
  .titlebar-mark{
    width:9px;height:9px;border-radius:2px;
    background:var(--accent);
    display:inline-block;
    transform:rotate(45deg);
  }
  .ai-frame .frame-titlebar{
    background:var(--ai-bg); color:var(--ai-text); border-bottom-color:var(--ai-border);
  }
  .ai-frame .titlebar-mark{ background:var(--ai-text); }
  .frame-titlebar .subtitle{
    font-size:11px; color:var(--muted); font-weight:400; margin-left:2px;
  }
  .ai-frame .subtitle{ color:var(--ai-text-soft); }

  /* ============ MENU BAR ============ */
  .menubar{
    display:flex;gap:2px;
    padding:6px 12px;
    border-bottom:1px solid var(--border);
    background:var(--surface-alt);
    flex:0 0 auto;
  }
  .menubar button{
    font-family:inherit;font-size:12.5px;font-weight:500;
    padding:6px 12px;
    background:transparent;
    color:var(--ink-soft);
    border:none;
    border-radius:var(--radius-sm);
    cursor:default;
  }
  .menubar button:hover{ background:#e9edf3; color:var(--ink); }

  /* ============ MAIN CONTENT: table + gantt ============ */
  .main-row{
    flex:1 1 auto;
    display:flex;
    min-height:0;
    border-bottom:1px solid var(--border);
  }

  /* -------- Activity table -------- */
  .activity-pane{
    width:40%;
    min-width:280px;
    border-right:1px solid var(--border);
    display:flex;flex-direction:column;
    min-height:0;
  }
  .pane-scroll{ overflow:auto; flex:1 1 auto; min-height:0; }
  table.acttable{
    border-collapse:collapse;
    width:100%;
    font-size:12px;
    table-layout:fixed;
  }
  table.acttable th{
    position:sticky;top:0;z-index:2;
    background:var(--surface-alt);
    border-bottom:1px solid var(--border-strong);
    padding:8px 10px;
    text-align:left;
    font-weight:600;
    font-size:10.5px;
    color:var(--ink-soft);
    text-transform:uppercase;
    letter-spacing:.4px;
    white-space:nowrap;
  }
  table.acttable td{
    border-bottom:1px solid var(--border);
    padding:5px 10px;
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
    height:26px;
  }
  table.acttable tbody tr{ cursor:pointer; transition:background .1s ease; }
  table.acttable tbody tr:hover td{ background:#f4f6fa; }
  table.acttable tbody tr.wbs td{ font-weight:600; }
  table.acttable tbody tr.selected td{ background:var(--accent-soft) !important; }
  table.acttable tbody tr.selected td:first-child{ box-shadow:inset 3px 0 0 var(--accent); }
  .col-id{ width:64px; color:var(--muted); }
  .col-dur{ width:42px; text-align:right; color:var(--ink-soft); }
  .col-pct{ width:38px; text-align:right; color:var(--ink-soft); }
  .name-cell{ display:flex; align-items:center; gap:6px; }
  .icon{ flex:0 0 auto; width:12px; text-align:center; font-size:9px; color:var(--muted); }
  .indent{ display:inline-block; }
  .tree-toggle{
    flex:0 0 auto; width:14px; height:14px; padding:0;
    border:none; background:transparent; color:var(--ink-soft);
    font-size:9px; line-height:1; cursor:pointer; border-radius:3px;
    display:inline-flex; align-items:center; justify-content:center;
    transition:transform .15s ease, background .12s ease;
  }
  .tree-toggle:hover{ background:var(--border); color:var(--ink); }
  .tree-toggle.open{ transform:rotate(90deg); }
  .tree-spacer{ flex:0 0 auto; width:14px; display:inline-block; }
  .row-name{ overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }

  /* -------- Gantt pane -------- */
  .gantt-pane{
    flex:1 1 auto;
    min-width:0;
    display:flex;flex-direction:column;
    background:var(--surface);
  }
  .gantt-scroll{ overflow:auto; flex:1 1 auto; min-height:0; position:relative; }
  .gantt-inner{ position:relative; }
  .gantt-header{ position:sticky;top:0;z-index:3; background:var(--surface-alt); }
  .qtr-row, .month-row{ display:flex; }
  .qtr-cell{
    border-right:1px solid var(--border);
    border-bottom:1px solid var(--border-strong);
    font-size:10.5px;font-weight:600;color:var(--ink-soft);
    text-align:center; padding:5px 0; white-space:nowrap;
  }
  .month-cell{
    border-right:1px solid var(--border);
    border-bottom:1px solid var(--border);
    font-size:9.5px; text-align:center; color:var(--muted);
    padding:3px 0;
  }
  .gantt-body{ position:relative; }
  .gantt-row{ height:26px; position:relative; border-bottom:1px solid var(--border); }
  .gantt-row.selected{ background:var(--accent-soft); }
  .vgrid{ position:absolute; top:0; bottom:0; border-left:1px solid #eef0f4; }
  .vgrid.qtr{ border-left:1px solid var(--border-strong); }

  .bar{ position:absolute; top:7px; height:9px; background:var(--ink); border-radius:5px; }
  .bar.summary{ top:11px; height:2px; background:var(--ink-soft); }
  .bar.summary::before,.bar.summary::after{
    content:"";position:absolute;top:-3px;width:0;height:0;
    border-left:4px solid transparent;border-right:4px solid transparent;
    border-top:6px solid var(--ink-soft);
  }
  .bar.summary::before{ left:-1px; } .bar.summary::after{ right:-1px; }
  .diamond{
    position:absolute; top:6px; width:10px;height:10px;
    background:var(--accent); transform:rotate(45deg); border-radius:2px;
  }
  .square{
    position:absolute; top:8px; width:8px;height:8px;
    border:2px solid var(--info); background:#fff; border-radius:2px;
  }
  .bar-label{ position:absolute; top:5px; left:0; font-size:10.5px; color:var(--ink-soft); white-space:nowrap; padding-left:7px; }

  /* ============ Details Space ============ */
  .details-pane{ flex:1 1 auto; display:flex; flex-direction:column; min-height:0; }
  .tabstrip{ display:flex; gap:4px; padding:8px 18px 0; border-bottom:1px solid var(--border); flex:0 0 auto; }
  .tabstrip button{
    font-family:inherit;font-size:12px;font-weight:500;
    padding:7px 4px 9px; margin-right:14px;
    background:none; color:var(--muted);
    border:none; border-bottom:2px solid transparent;
    cursor:default;
  }
  .tabstrip button.active{ color:var(--ink); border-bottom-color:var(--accent); font-weight:600; }
  .details-body{ flex:1 1 auto; overflow:auto; padding:18px; }
  .details-grid{
    display:grid; grid-template-columns:140px 1fr 140px 1fr;
    gap:10px 18px; max-width:780px; font-size:12.5px;
  }
  .details-grid label{ color:var(--muted); align-self:center; font-weight:500; }
  .details-grid .field{
    border:1px solid var(--border); border-radius:var(--radius-sm);
    background:var(--surface-alt); padding:6px 10px; min-height:14px;
  }
  .details-empty{ color:var(--muted); font-size:12.5px; }

  /* ============ AI Frame Sections ============ */
  .ai-body{ flex:1 1 auto; overflow-y:auto; display:flex; flex-direction:column; gap:10px; padding:10px; }
  .ai-section{
    background:var(--ai-surface);
    border:1px solid var(--ai-border);
    border-radius:var(--radius-md);
    display:flex; flex-direction:column;
    flex:0 0 auto;
    overflow:hidden;
  }
  .ai-section.expanded{ flex:1 1 230px; min-height:170px; }
  .ai-section-head{ display:flex; align-items:center; gap:8px; padding:10px 12px; border-bottom:1px solid transparent; }
  .ai-section.expanded .ai-section-head{ border-bottom-color:var(--ai-border); }
  .collapse-btn{
    width:20px;height:20px;flex:0 0 auto;
    border:none;background:transparent;color:var(--ai-text-soft);
    font-size:11px; cursor:pointer; border-radius:5px;
    display:flex;align-items:center;justify-content:center;
    transition:transform .15s ease, background .15s ease;
  }
  .collapse-btn:hover{ background:var(--ai-surface3); color:var(--ai-text); }
  .section-title{ font-size:12.5px; font-weight:600; color:var(--ai-text); }
  .section-count{
    margin-left:auto; font-size:10.5px; color:var(--ai-text-soft);
    background:var(--ai-surface3); padding:2px 8px; border-radius:20px;
  }
  .ai-section-content{ overflow:hidden; display:flex; flex-direction:column; padding:0 10px 10px; flex:1 1 auto; min-height:0; }
  .ai-section.collapsed .ai-section-content{ display:none; }
  .feed-list{ display:flex; flex-direction:column; gap:6px; overflow-y:auto; flex:1 1 auto; min-height:0; padding-top:4px; }

