function lblGuess(text){ return Math.min(text.length*5.4, 220); }

function buildGanttRow(i){
  const a = activities[i];
  const row = document.createElement("div");
  row.className = "gantt-row";
  row.dataset.index = i;
  if(i === currentIndex) row.classList.add("selected");
  row.style.width = TOTAL_W+"px";

  for(let m=0;m<=TOTAL_MONTHS;m++){
    const vg = document.createElement("div");
    vg.className = "vgrid" + (m%3===0 ? " qtr":"");
    vg.style.left = (m*MONTH_W)+"px";
    row.appendChild(vg);
  }

  const left = a.start*MONTH_W;
  const width = Math.max((a.end-a.start)*MONTH_W, 4);

  if(a.type === "wbs"){
    const bar = document.createElement("div");
    bar.className = "bar summary";
    bar.style.left = left+"px"; bar.style.width = width+"px";
    row.appendChild(bar);
    const lbl = document.createElement("div");
    lbl.className = "bar-label"; lbl.style.left = (left+width+4)+"px";
    lbl.textContent = a.dateLabel;
    row.appendChild(lbl);
  } else if(a.type === "milestone"){
    const d = document.createElement("div");
    d.className = "diamond"; d.style.left = (left-5)+"px";
    row.appendChild(d);
    const lbl = document.createElement("div");
    lbl.className = "bar-label";
    if(a.labelSide==="left"){ lbl.style.left = (left-4-lblGuess(a.dateLabel))+"px"; }
    else { lbl.style.left = (left+8)+"px"; }
    lbl.textContent = a.dateLabel;
    row.appendChild(lbl);
  } else if(a.type === "square"){
    const s = document.createElement("div");
    s.className = "square"; s.style.left = left+"px";
    row.appendChild(s);
    const lbl = document.createElement("div");
    lbl.className = "bar-label"; lbl.style.left = (left+14)+"px";
    lbl.textContent = a.dateLabel;
    row.appendChild(lbl);
  } else {
    const bar = document.createElement("div");
    bar.className = "bar"; bar.style.left = left+"px"; bar.style.width = width+"px";
    row.appendChild(bar);
    const lbl = document.createElement("div");
    lbl.className = "bar-label"; lbl.style.left = (left+width+4)+"px";
    lbl.textContent = a.dateLabel;
    row.appendChild(lbl);
  }
  return row;
}

function renderGanttBody(visible){
  ganttBody.innerHTML = "";
