function buildWbsPath(matchIndex){
  const target = activities[matchIndex];
  const path = [target.name];
  let level = target.level;
  for(let i=matchIndex-1;i>=0 && level>0;i--){
    if(activities[i].level < level){ path.unshift(activities[i].name); level = activities[i].level; }
  }
  return path.join(" \u203a ");
}

function statusChipHtml(item){
  if(!item.status) return "";
  return `<span class="status-chip ${item.status}">${item.status==="accepted"?"Accepted":"Declined"}</span>`;
}

/* Central status setter — keeps the sidebar mini-list and the full drawer in sync
   no matter which surface the Accept/Decline/Edit action happened on. */
function applyReviewStatus(idx, status){
  reviewItems[idx].status = status;
  renderReviewMiniList();
  if(currentAgentTabIndex === idx) renderMiniAgentTab(idx);
  if(reviewDrawerOverlay.classList.contains("open")){
    renderDrawerList();
    if(drawerCurrentIdx === idx) renderDrawerDetail(idx);
  }
}

