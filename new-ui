function monthOffsetToDate(offset){
  const base = new Date(2018,3,1);
  const d = new Date(base.getFullYear(), base.getMonth()+Math.floor(offset), 1 + Math.round((offset%1)*28));
  return d.toLocaleDateString("en-GB",{day:"2-digit",month:"short",year:"2-digit"});
}

