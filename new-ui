function showEditPanel(idx, panelId, rerenderFn){
  const panel = document.getElementById(panelId);
  const options = activities
    .map((a,i)=> a.id ? `<option value="${i}">${a.id} — ${a.name}</option>` : "")
    .filter(Boolean).join("");
  panel.innerHTML = `
    <div class="edit-panel">
      <div class="field-label">Reassign to activity</div>
      <select id="${panelId}Select">${options}</select>
      <div class="edit-actions">
        <button class="btn-save" id="${panelId}Save">Save match</button>
        <button class="btn-cancel" id="${panelId}Cancel">Cancel</button>
      </div>
    </div>
  `;
  document.getElementById(`${panelId}Select`).value = reviewItems[idx].matchIndex;
  document.getElementById(`${panelId}Save`).addEventListener("click", ()=>{
    const newIndex = parseInt(document.getElementById(`${panelId}Select`).value,10);
    reviewItems[idx].matchIndex = newIndex;
    reviewItems[idx].confidence = 100;
    reviewItems[idx].status = "accepted";
    rerenderFn(idx);
    applyReviewStatus(idx, "accepted");
  });
  document.getElementById(`${panelId}Cancel`).addEventListener("click", ()=>{ panel.innerHTML = ""; });
}

