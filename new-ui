  visible.forEach(i=>{
    const a = activities[i];
    const tr = document.createElement("tr");
    tr.dataset.index = i;
    if(a.type==="wbs") tr.classList.add("wbs");
    if(i === currentIndex) tr.classList.add("selected");
    const hasKids = a._children.length>0;
    const toggleHtml = hasKids
