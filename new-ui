/* =========================================================
   TREE STRUCTURE (project > sub-projects > activities > sub-activities)
   ========================================================= */
function computeStructure(){
  const stack = [];
  activities.forEach((a,i)=>{
    a._children = [];
    while(stack.length && activities[stack[stack.length-1]].level >= a.level) stack.pop();
    a._parent = stack.length ? stack[stack.length-1] : -1;
    if(a._parent >= 0) activities[a._parent]._children.push(i);
    stack.push(i);
  });
}
computeStructure();

const collapsedSet = new Set();
(function initCollapseState(){
  // start with every branch node collapsed...
  activities.forEach((a,i)=>{ if(a._children.length) collapsedSet.add(i); });
  // ...except the ancestor chain of the initially-selected activity, so it's visible on load
  let defaultIndex = activities.findIndex(a=>a.selected);
  if(defaultIndex < 0) defaultIndex = 0;
  let p = activities[defaultIndex]._parent;
  while(p >= 0){ collapsedSet.delete(p); p = activities[p]._parent; }
})();

function isVisible(i){
  let p = activities[i]._parent;
  while(p >= 0){
    if(collapsedSet.has(p)) return false;
    p = activities[p]._parent;
  }
  return true;
}
function computeVisible(){
  const out = [];
  activities.forEach((a,i)=>{ if(isVisible(i)) out.push(i); });
  return out;
}
function toggleCollapse(i){
  if(collapsedSet.has(i)) collapsedSet.delete(i); else collapsedSet.add(i);
  renderAll();
}

/* =========================================================
